{
  "name": "tangledbuses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:live": "tsc --noEmit && vite build --mode live",
    "preview": "vite preview",
    "bundle": "node scripts/bundle.mjs",
    "favicon": "node scripts/favicon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project chromium --project webkit",
    "perf": "npm run build && PERF=1 playwright test --project chromium-gpu",
    "preview:phone": "npm run build && EXPORT=export_131026 vite preview --host --port 4173 --strictPort"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@preact/signals": "2.11.4",
    "maplibre-gl": "6.16.0",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.29.7",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
