{
  "name": "busrouter-london",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:live": "tsc --noEmit && vite build --mode live",
    "preview": "vite preview",
    "bundle": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@preact/signals": "2.11.4",
    "maplibre-gl": "6.16.0",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
