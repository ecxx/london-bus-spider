# prod_design 7. Cloudflare Pages applies each rule that matches a path.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

/data/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
